# Dejar vacío en desarrollo para que las llamadas vayan a /api (proxy de Vite).
VITE_API_BASE_URL=

# Destino del proxy en `npm run dev`. Si se omite, Vite usa el valor por defecto del proyecto.
DEV_API_PROXY_TARGET=http://161.153.193.159:8080

# Opcional. La API oficial no tiene GET /health/ready. No activar salvo una instalación que sí lo exponga.
# VITE_ENABLE_HEALTH_READY=true
